---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImagePaths from '../data/hero-images.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImages = heroImagePaths.map((image) => `${base}${image}`);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    {heroImages.map((image, index) => (
      <div
        class:list={[
          'hero-image',
          'hero-slide',
          { 'is-active': index === 0 },
        ]}
        style={`background-image: url("${image}")`}
        aria-hidden="true"
      ></div>
    ))}
    <div class="hero-shade"></div>

    <div class="hero-content page-container">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot"></span>
        BAPAK BAPAK SENGGANG · BANDUNG
      </p>

      <h1 id="hero-title">
        SIBUK BOLEH,<br />
        SENGGANG <span></span><br />
        HARUS<span class="hero-period">.</span>
      </h1>

      <div class="hero-bottom">
        <p>
          Bukan sekadar tentang ke mana kita pergi.
          Ini tentang perjalanan, persaudaraan, dan cerita di sepanjang jalan.
        </p>

        <a class="round-link" href="#about" aria-label="Jelajahi cerita BBS Bandung">
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="hero-index" aria-hidden="true">
      <span>01</span>
      <span class="hero-index-line"></span>
      <span>THE JOURNEY</span>
    </div>
  </section>

  <script>
    const heroSection = document.querySelector<HTMLElement>('.hero');
    const heroSlides = Array.from(
      document.querySelectorAll<HTMLElement>('.hero-slide')
    );

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let heroTimer: number | undefined;
    let currentHeroIndex = 0;

    const showHeroSlide = (index: number) => {
      heroSlides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === index);
      });

      currentHeroIndex = index;
    };

    const stopHeroSlideshow = () => {
      if (heroTimer !== undefined) {
        window.clearInterval(heroTimer);
        heroTimer = undefined;
      }
    };

    const startHeroSlideshow = () => {
      stopHeroSlideshow();

      if (
        heroSlides.length < 2 ||
        document.hidden ||
        reducedMotion.matches
      ) {
        return;
      }

      heroTimer = window.setInterval(() => {
        const nextIndex = (currentHeroIndex + 1) % heroSlides.length;
        showHeroSlide(nextIndex);
      }, 5000);
    };

    if (heroSection && heroSlides.length > 0) {
      showHeroSlide(0);
      startHeroSlideshow();

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopHeroSlideshow();
        } else {
          startHeroSlideshow();
        }
      });

      reducedMotion.addEventListener('change', startHeroSlideshow);
    }
  </script>

  <section class="intro-section section-pad" id="about">
    <div class="page-container intro-grid">
      <div class="section-label">
        <span class="section-number">01 / ABOUT</span>
        <span class="label-rule"></span>
      </div>

      <div class="intro-copy">
        <p class="eyebrow">MORE THAN A RIDE</p>

        <h2>
          THE ROAD IS BETTER<br />
          <span>WHEN WE RIDE TOGETHER.</span>
        </h2>

        <div class="intro-description">
          <p>
            Setiap perjalanan membawa cerita. Dari jalanan kota sampai
            rute yang belum pernah dijelajahi, ada pengalaman yang layak
            dibagikan dan momen yang menjadi bagian dari perjalanan kita.
          </p>

          <p>
            BBS Chapter Bandung hadir sebagai ruang untuk mendokumentasikan
            perjalanan, kegiatan, dan kebersamaan di atas roda.
          </p>

          <a class="text-link" href="#chapter">
            GET TO KNOW US <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter-section" id="chapter">
    <div class="chapter-image">
      <img
        src={`${base}/images/community-02.jpg`}
        alt="Dokumentasi perjalanan komunitas"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="chapter-copy">
      <span class="section-number">02 / THE CHAPTER</span>
      <span class="chapter-symbol" aria-hidden="true">BBS.</span>

      <p class="eyebrow">ROOTED IN BANDUNG</p>

      <h2>ONE CHAPTER.<br />COUNTLESS STORIES.</h2>

      <p class="chapter-description">
        Dari titik kumpul hingga tujuan akhir, setiap perjalanan adalah
        bagian dari cerita yang terus berjalan. Bandung menjadi titik
        berangkat, sementara jalanan selalu membuka kemungkinan baru.
      </p>

      <a class="text-link" href="#activities">
        EXPLORE OUR JOURNEY <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="activities-section section-pad" id="activities">
    <div class="page-container">
      <div class="section-heading">
        <div>
          <span class="section-number">03 / WHAT WE DO</span>
          <p class="eyebrow">OUTSIDE THE ORDINARY</p>
          <h2>THE ROAD<br />CALLS <span>US.</span></h2>
        </div>

        <p class="section-heading-note">
          Bukan soal seberapa jauh kita pergi.<br />
          Tapi tentang cerita yang dibawa pulang.
        </p>
      </div>

      <div class="activity-grid">
        <article class="activity-card">
          <div class="activity-number">01</div>
          <span class="activity-icon" aria-hidden="true">↗</span>
          <h3>THE RIDE</h3>
          <p>
            Menjelajahi jalanan, menikmati perjalanan, dan mengabadikan
            momen di setiap pemberhentian.
          </p>
          <span class="activity-line"></span>
        </article>

        <article class="activity-card">
          <div class="activity-number">02</div>
          <span class="activity-icon" aria-hidden="true">◎</span>
          <h3>THE GATHERING</h3>
          <p>
            Bertemu, berbagi cerita, dan menikmati waktu bersama di luar
            rutinitas sehari-hari.
          </p>
          <span class="activity-line"></span>
        </article>

        <article class="activity-card">
          <div class="activity-number">03</div>
          <span class="activity-icon" aria-hidden="true">✳</span>
          <h3>THE MEMORIES</h3>
          <p>
            Mendokumentasikan perjalanan dan kegiatan sebagai bagian dari
            cerita BBS Chapter Bandung.
          </p>
          <span class="activity-line"></span>
        </article>
      </div>
    </div>
  </section>

  <section class="home-agenda-section section-pad" id="community-agenda">
    <div class="page-container">
      <div class="home-agenda-heading">
        <div>
          <span class="section-number">04 / COMMUNITY CALENDAR</span>
          <p class="eyebrow">SAVE THE DATE</p>
          <h2>COMMUNITY<br /><span>ACTIVITIES.</span></h2>
        </div>

        <div class="home-agenda-intro">
          <p>
            Dari agenda berikutnya hingga cerita di sepanjang jalan.
            Temukan kegiatan BBS Chapter Bandung.
          </p>
          <a class="home-agenda-all-link" href={`${base}/activities/`}>
            VIEW ALL ACTIVITIES <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="home-agenda-grid">
        <article class="home-agenda-card">
          <button
            class="home-agenda-poster-button"
            type="button"
            data-home-agenda-image={`${base}/images/activities/activities-2026-10-23.jpeg`}
            data-home-agenda-title="Agenda 23 Oktober 2026"
            aria-label="Perbesar poster agenda 23 Oktober 2026"
          >
            <img
              class="home-agenda-poster"
              src={`${base}/images/activities/activities-2026-10-23.jpeg`}
              alt="Poster agenda kegiatan BBS Chapter Bandung, 23 Oktober 2026"
              loading="lazy"
              decoding="async"
            />
            <span class="home-agenda-poster-zoom" aria-hidden="true">↗</span>
          </button>

          <div class="home-agenda-card-caption">
            <span class="home-agenda-card-number">01</span>
            <div>
              <p class="eyebrow">COMMUNITY AGENDA</p>
              <h3>23 OCTOBER 2026</h3>
              <p>Agenda kegiatan BBS Chapter Bandung.</p>
            </div>
          </div>
        </article>

        <article class="home-agenda-card home-agenda-next-card">
          <a class="home-agenda-next-slot" href={`${base}/activities/`}>
            <span class="home-agenda-next-number">02</span>
            <span class="home-agenda-next-plus" aria-hidden="true">+</span>
            <span class="home-agenda-next-label">NEXT ACTIVITY</span>
            <span class="home-agenda-next-hint">DETAILS COMING SOON</span>
          </a>

          <div class="home-agenda-card-caption">
            <span class="home-agenda-card-number">02</span>
            <div>
              <p class="eyebrow">COMING NEXT</p>
              <h3>NEXT ACTIVITY</h3>
              <p>Agenda berikutnya akan diumumkan di halaman Activities.</p>
            </div>
          </div>
        </article>
      </div>
    </div>

    <dialog class="home-agenda-lightbox" aria-label="Pratinjau poster agenda">
      <div class="home-agenda-lightbox-toolbar">
        <span>BBS / COMMUNITY ACTIVITIES</span>
        <button
          class="home-agenda-lightbox-close"
          type="button"
          aria-label="Tutup poster"
        >
          CLOSE <span aria-hidden="true">×</span>
        </button>
      </div>
      <img class="home-agenda-lightbox-image" src="" alt="" />
      <p class="home-agenda-lightbox-caption"></p>
    </dialog>
  </section>

  <script>
    const homeAgendaButtons = document.querySelectorAll<HTMLButtonElement>(
      '.home-agenda-poster-button'
    );
    const homeAgendaDialog = document.querySelector<HTMLDialogElement>(
      '.home-agenda-lightbox'
    );
    const homeAgendaDialogImage = document.querySelector<HTMLImageElement>(
      '.home-agenda-lightbox-image'
    );
    const homeAgendaDialogCaption = document.querySelector<HTMLElement>(
      '.home-agenda-lightbox-caption'
    );
    const homeAgendaClose = document.querySelector<HTMLButtonElement>(
      '.home-agenda-lightbox-close'
    );

    homeAgendaButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const imagePath = button.dataset.homeAgendaImage;

        if (
          !imagePath ||
          !homeAgendaDialog ||
          !homeAgendaDialogImage ||
          !homeAgendaDialogCaption
        ) {
          return;
        }

        homeAgendaDialogImage.src = imagePath;
        homeAgendaDialogImage.alt =
          button.querySelector('img')?.alt || 'Poster agenda BBS';
        homeAgendaDialogCaption.textContent =
          button.dataset.homeAgendaTitle || 'Community agenda';

        homeAgendaDialog.showModal();
      });
    });

    const closeHomeAgendaDialog = () => {
      if (homeAgendaDialog?.open) homeAgendaDialog.close();
    };

    homeAgendaClose?.addEventListener('click', closeHomeAgendaDialog);

    homeAgendaDialog?.addEventListener('click', (event) => {
      if (event.target === homeAgendaDialog) {
        closeHomeAgendaDialog();
      }
    });

    homeAgendaDialog?.addEventListener('close', () => {
      if (homeAgendaDialogImage) {
        homeAgendaDialogImage.src = '';
        homeAgendaDialogImage.alt = '';
      }
    });
  </script>

  <section class="gallery-section" id="gallery">
    <div class="gallery-heading page-container">
      <div>
        <span class="section-number">04 / SELECTED MOMENTS</span>
        <p class="eyebrow">LIFE IN MOTION</p>
        <h2>OUT THERE<span>.</span></h2>
      </div>

      <p>
        Some roads become memories.<br />
        Some moments become stories.
      </p>
    </div>

    <div class="gallery-grid page-container">
      <figure class="gallery-item gallery-item-large">
        <img
          src={`${base}/images/community-01.jpg`}
          alt="Foto perjalanan BBS Bandung"
          loading="lazy"
          decoding="async"
        />
        <figcaption><span>01</span> THE JOURNEY</figcaption>
      </figure>

      <figure class="gallery-item gallery-item-small">
        <img
          src={`${base}/images/community-02.jpg`}
          alt="Momen kebersamaan komunitas"
          loading="lazy"
          decoding="async"
        />
        <figcaption><span>02</span> THE MOMENT</figcaption>
      </figure>
    </div>

    <div class="gallery-foot page-container">
      <span>DOCUMENTING THE ROAD, ONE RIDE AT A TIME.</span>
      <a class="text-link" href="#contact">
        MORE ABOUT BBS <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="closing-section">
    <div class="closing-text page-container">
      <p class="eyebrow">THE NEXT MILE AWAITS</p>
      <h2>KEEP THE<br />STORY <span>ROLLING.</span></h2>
      <a class="closing-link" href="#contact">
        STAY CONNECTED <span aria-hidden="true">↗</span>
      </a>
    </div>
    <span class="closing-watermark" aria-hidden="true">BBS</span>
  </section>
</BaseLayout>
