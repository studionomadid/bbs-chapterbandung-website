---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BBS Chapter Bandung — Bapak Bapak Senggang',
  description = 'Dokumentasi perjalanan, kegiatan, dan cerita Bapak Bapak Senggang Chapter Bandung.'
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content={description} />

    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/favicon/favicon-32x32.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/favicon/apple-touch-icon.png`}
    />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <div id="top"></div>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
